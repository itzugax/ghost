# Supabase Configuration (copy from supabase-config.js)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Backblaze B2 Configuration
# Get these from https://secure.backblaze.com/user/app_keys.htm
B2_KEY_ID=YOUR_KEY_ID
B2_APPLICATION_KEY=YOUR_APPLICATION_KEY
B2_BUCKET_ID=YOUR_BUCKET_ID
B2_BUCKET_NAME=YOUR_BUCKET_NAME
B2_ENDPOINT=s3.us-east-005.backblazeb2.com
B2_PROXY_PORT=3001

# B2 Proxy Security Token (optional, for production)
B2_PROXY_TOKEN=YOUR_RANDOM_TOKEN

# CORS
B2_ALLOWED_ORIGINS=https://gdrop.vercel.app

# Rate Limiting
B2_MAX_UPLOAD_MB=500
B2_RATE_LIMIT_WINDOW_MS=60000
B2_RATE_LIMIT_MAX_REQUESTS=120
