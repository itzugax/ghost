{
  "name": "ghost-drop",
  "version": "3.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx serve . -p 3000",
    "proxy": "node b2-proxy.js",
    "start": "concurrently \"npm run dev\" \"npm run proxy\"",
    "start:dev": "npm run check && npm start",
    "check": "node -e \"console.log('🔍 Verificando configuración...'); process.exit(0)\"",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:chrome": "playwright test --project=chromium",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "health": "node -e \"console.log('Ejecuta healthCheck() en la consola del navegador')\""
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.490.0",
    "@aws-sdk/s3-request-presigner": "^3.490.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "cors": "^2.8.5",
    "concurrently": "^8.2.2"
  }
}
