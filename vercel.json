{
  "version": 2,
  "builds": [
    {
      "src": "b2-proxy.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/health",
      "dest": "b2-proxy.js"
    },
    {
      "src": "/setup-cors",
      "dest": "b2-proxy.js"
    },
    {
      "src": "/get-upload-url",
      "dest": "b2-proxy.js"
    },
    {
      "src": "/upload",
      "dest": "b2-proxy.js"
    },
    {
      "src": "/download/(.*)",
      "dest": "b2-proxy.js"
    },
    {
      "src": "/delete/(.*)",
      "dest": "b2-proxy.js"
    }
  ]
}
