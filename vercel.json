{
  "version": 2,
  "builds": [
    {
      "src": "b2-proxy.js",
      "use": "@vercel/node"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "crypto.js",
      "use": "@vercel/static"
    },
    {
      "src": "i18n.js",
      "use": "@vercel/static"
    },
    {
      "src": "storage-b2-client.js",
      "use": "@vercel/static"
    },
    {
      "src": "supabase.min.js",
      "use": "@vercel/static"
    },
    {
      "src": "qrcode.min.js",
      "use": "@vercel/static"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.svg",
      "use": "@vercel/static"
    },
    {
      "src": "*.json",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/health",
      "dest": "/b2-proxy.js"
    },
    {
      "src": "/setup-cors",
      "dest": "/b2-proxy.js"
    },
    {
      "src": "/get-upload-url",
      "dest": "/b2-proxy.js"
    },
    {
      "src": "/upload",
      "dest": "/b2-proxy.js"
    },
    {
      "src": "/download/(.*)",
      "dest": "/b2-proxy.js"
    },
    {
      "src": "/delete/(.*)",
      "dest": "/b2-proxy.js"
    }
  ]
}
